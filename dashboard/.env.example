# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # dashboard auth (client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # server-side, RLS bypass — SECRET

# AES-256-GCM key for encrypting FCM service-account JSON at rest.
# 32 bytes hex (64 chars). Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Protects the Vercel Cron dispatch endpoint. Generate: openssl rand -hex 32
CRON_SECRET=

# Bootstrap token for POST /api/apps (app creation before full auth UI). Generate: openssl rand -hex 32
ADMIN_SETUP_TOKEN=
